# Local trusted-suite mode. Secrets belong in the suite credentials directory.
HATH0R_MCP_HOST_PORT=38083
HATH0R_MCP_ENVIRONMENT=local
# Set production and a strong token (32+ characters) outside trusted local use.
HATH0R_MCP_TOKEN=
# JSON arrays; set only when adding an explicitly trusted host/origin.
# HATH0R_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","hath0r-mcp:*","hath0rmcp:*"]
# HATH0R_MCP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
