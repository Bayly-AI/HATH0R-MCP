{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-cli-diagnostic-v1.schema.json",
  "title": "hath0r.cli.diagnostic/1",
  "description": "Structured diagnostic entry for hath0r CLI machine responses (HATHOR-TS-005 §5).",
  "type": "object",
  "additionalProperties": true,
  "required": ["code", "message", "severity"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Stable diagnostic code in uppercase snake case.",
      "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
      "examples": ["KNOWLEDGEBASE_NOT_FOUND", "USAGE_INVALID", "INTERNAL_ERROR"]
    },
    "message": {
      "type": "string",
      "description": "Operator-safe message containing no secrets.",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "description": "Diagnostic severity.",
      "enum": ["error", "warning", "info"]
    },
    "remediation": {
      "type": "string",
      "description": "Next safe action for the operator."
    },
    "provenance": {
      "type": "object",
      "description": "Emitter identity for the diagnostic.",
      "additionalProperties": true,
      "required": ["component", "operation"],
      "properties": {
        "component": {
          "type": "string",
          "description": "Producing component identity (e.g. hath0r-cli).",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "description": "Operation that emitted the diagnostic (e.g. doctor, kb.path).",
          "minLength": 1
        }
      }
    },
    "ttl": {
      "description": "Bounded offline trust lifetime when applicable; null when not used.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "details": {
      "type": "object",
      "description": "Schema-bounded extra context; must not contain environment dumps or secrets.",
      "additionalProperties": true
    }
  }
}
