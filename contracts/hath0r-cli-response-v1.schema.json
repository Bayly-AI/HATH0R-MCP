{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-cli-response-v1.schema.json",
  "title": "hath0r.cli.response/1",
  "description": "Top-level structured JSON response envelope for hath0r CLI machine output (HATHOR-TS-005 §4).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "command",
    "generated_at",
    "state",
    "data",
    "diagnostics",
    "meta"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "description": "Exact response schema major identity. Consumers must refuse unsupported majors.",
      "const": "hath0r.cli.response/1"
    },
    "command": {
      "type": "string",
      "description": "Stable operation identity (not raw argv). Examples: version, doctor, kb.path, kb.products.",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "description": "UTC result timestamp as RFC 3339 / ISO 8601 date-time.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "state": {
      "type": "string",
      "description": "Overall result state for the operation.",
      "enum": ["ok", "degraded", "unavailable", "error"]
    },
    "data": {
      "description": "Command-specific payload object, or null when no payload applies.",
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "diagnostics": {
      "type": "array",
      "description": "Structured refusals, warnings, and remediation entries.",
      "items": {
        "$ref": "hath0r-cli-diagnostic-v1.schema.json"
      }
    },
    "meta": {
      "type": "object",
      "description": "Producer metadata for the response.",
      "additionalProperties": true,
      "required": ["cli_version", "duration_ms"],
      "properties": {
        "cli_version": {
          "type": "string",
          "description": "Producing package version (SemVer).",
          "minLength": 1,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "duration_ms": {
          "type": "integer",
          "description": "Bounded command duration in milliseconds.",
          "minimum": 0
        }
      }
    }
  }
}
